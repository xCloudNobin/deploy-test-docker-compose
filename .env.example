# Copy to .env and set a strong POSTGRES_PASSWORD before starting.
# Every value here is a NON-SECRET placeholder; never commit a real password.

# Host port for the only published service (the frontend).
FRONTEND_PORT=8188

# PostgreSQL database name and role.
POSTGRES_DB=taskboard
POSTGRES_USER=taskboard

# REQUIRED. Use a long random value, for example:
#   openssl rand -hex 32
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Non-sensitive release marker shown in the UI footer and /api/meta.
# Defaults to "local" when unset; export the commit SHA in production.
APP_RELEASE=local